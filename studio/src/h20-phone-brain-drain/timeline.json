      "end": 12.893,
      "startFrame": 254,
      "endFrame": 387,
      "words": 8,
      "text": "In 2017, scientists gave people a memory test."
    },
    {
      "i": 3,
      "start": 13.693,
      "end": 16.637,
      "startFrame": 411,
      "endFrame": 499,
      "words": 9,
