    },
    {
      "i": 4,
      "start": 17.437,
      "end": 19.997,
      "startFrame": 523,
      "endFrame": 600,
      "words": 8,
      "text": "So people said phones make us less smart."
    },
    {
      "i": 5,
      "start": 20.897,
      "end": 24.289,
      "startFrame": 627,
      "endFrame": 729,
      "words": 10,
      "text": "But others repeated the test, and the difference was gone."
    },
    {
      "i": 6,
      "start": 25.089,
      "end": 28.097,
      "startFrame": 753,
      "endFrame": 843,
      "words": 8,
      "text": "Then a review looked at fifty-six studies together."
