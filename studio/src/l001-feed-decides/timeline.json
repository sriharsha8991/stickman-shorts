      "i": 75,
      "start": 248.429,
      "end": 250.392,
      "startFrame": 7453,
      "endFrame": 7512,
      "words": 4,
      "text": "choose \"Don't recommend channel.\""
    },
    {
      "i": 76,
      "start": 251.192,
      "end": 254.477,
      "startFrame": 7536,
      "endFrame": 7634,
      "words": 8,
      "text": "Bonus move: search for what you actually want."
    },
    {
      "i": 77,
      "start": 255.277,
      "end": 257.261,
      "startFrame": 7658,
      "endFrame": 7718,
      "words": 5,
      "text": "Your searches are signals too."
    },
    {
      "i": 78,
      "start": 258.061,
      "end": 260.899,
      "startFrame": 7742,
      "endFrame": 7827,
      "words": 10,
      "text": "None of this is hidden. It's all in your hands."
    },
