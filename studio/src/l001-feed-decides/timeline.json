      "i": 73,
      "start": 241.091,
      "end": 244.205,
      "startFrame": 7233,
      "endFrame": 7326,
      "words": 7,
      "text": "open its menu and choose \"Not interested.\""
    },
    {
      "i": 74,
      "start": 245.005,
      "end": 247.629,
      "startFrame": 7350,
      "endFrame": 7429,
      "words": 9,
      "text": "Tap three: if a whole channel isn't for you,"
    },
