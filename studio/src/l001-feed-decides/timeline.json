      "i": 70,
      "start": 231.672,
      "end": 234.168,
      "startFrame": 6950,
      "endFrame": 7025,
      "words": 9,
      "text": "You can pause it, edit it, or delete it."
    },
    {
      "i": 71,
      "start": 234.968,
      "end": 237.123,
      "startFrame": 7049,
      "endFrame": 7114,
      "words": 6,
      "text": "Clear out the videos you regret."
    },
    {
      "i": 72,
      "start": 237.923,
      "end": 240.291,
      "startFrame": 7138,
      "endFrame": 7209,
      "words": 8,
      "text": "Tap two: on a video you don't want,"
    },
