      "i": 80,
      "start": 264.107,
      "end": 267.157,
      "startFrame": 7923,
      "endFrame": 8015,
      "words": 8,
      "text": "It reads your history, searches, likes and taps."
    },
    {
      "i": 81,
      "start": 267.957,
      "end": 270.432,
      "startFrame": 8039,
      "endFrame": 8113,
      "words": 8,
      "text": "It scores a few hundred videos for you."
    },
