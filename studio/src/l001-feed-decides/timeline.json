      "i": 83,
      "start": 274.677,
      "end": 276.491,
      "startFrame": 8240,
      "endFrame": 8295,
      "words": 5,
      "text": "And every tap teaches it."
    },
    {
      "i": 84,
      "start": 277.291,
      "end": 279.424,
      "startFrame": 8319,
      "endFrame": 8383,
      "words": 6,
      "text": "You're not just watching the feed."
    },
